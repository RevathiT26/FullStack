{
  "name": "treenode",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.7",
    "@mdi/font": "7.4.47",
    "axios": "^1.13.2",
    "pinia": "^3.0.4",
    "rxjs": "^7.8.2",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "vuetify": "^3.10.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vitest/ui": "^4.0.7",
    "@vue/compiler-sfc": "^3.5.24",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.35.0",
    "eslint-config-vuetify": "^4.2.0",
    "happy-dom": "^12.10.0",
    "jsdom": "^27.0.1",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.92.1",
    "typescript": "^5.0.0",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-components": "^29.0.0",
    "unplugin-vue-router": "^0.15.0",
    "vite": "^5.0.0",
    "vite-plugin-vuetify": "^1.0.0",
    "vitest": "^1.0.0",
    "vue-tsc": "^1.8.0",
    "vuetify": "^3.4.0"
